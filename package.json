{
  "name": "imds-platform-control-plane",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "validate:env": "node scripts/validate-build-env.mjs",
    "validate:repository": "node scripts/validate-repository.mjs",
    "lint": "tsc --noEmit",
    "build": "npm run validate:env && tsc -b && vite build",
    "build:production": "IMDS_STRICT_ENV=true VITE_APP_ENV=production npm run build",
    "test:smoke:frontend": "node scripts/smoke-frontend.mjs",
    "check": "npm run validate:repository && npm run lint && npm run build && npm run test:smoke:frontend",
    "test:e2e:crm-kanban": "node tests/crm-kanban-e2e.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  }
}
